<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.5.0</Version>
    <ApplicationIcon>img\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="img\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="NModbus.Serial" Version="3.0.83" />
  </ItemGroup>

  <Target Name="BuildInstaller" AfterTargets="Publish" Condition=" '$(Configuration)' == 'Release' ">
    <PropertyGroup>
      <MakensisPath>C:\Program Files (x86)\NSIS\makensis.exe</MakensisPath>
    </PropertyGroup>
    <Message Importance="high" Text="Building NSIS Installer..." Condition="Exists('$(MakensisPath)')" />
    <Exec Command="&quot;$(MakensisPath)&quot; installer.nsi" Condition="Exists('$(MakensisPath)')" />
    <Message Importance="high" Text="NSIS not found at $(MakensisPath). Installer was not automatically created. Please compile installer.nsi manually." Condition="!Exists('$(MakensisPath)')" />
  </Target>

</Project>
