<Window x:Class="ModbusMonitor.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection Settings" SizeToContent="Height" Width="400" Background="#F8F9FA" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" MinHeight="400">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B5ED7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C636A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Protocol Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Protocol:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbProtocol" SelectedIndex="0" Padding="5" SelectionChanged="CmbProtocol_SelectionChanged">
                <ComboBoxItem Content="Modbus TCP"/>
                <ComboBoxItem Content="Modbus RTU over TCP"/>
                <ComboBoxItem Content="Modbus RTU (Serial)"/>
                <ComboBoxItem Content="Modbus ASCII (Serial)"/>
            </ComboBox>

            <TextBlock Text="Timeout (ms):" FontWeight="SemiBold" Margin="0,15,0,5"/>
            <TextBox x:Name="txtTimeout" Text="2000" Padding="5"/>
        </StackPanel>

        <!-- TCP Settings Panel -->
        <StackPanel x:Name="pnlTcpSettings" Grid.Row="1" Visibility="Visible">
            <TextBlock Text="IP Address:" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="txtIpAddress" Text="127.0.0.1" Padding="5"/>
            
            <TextBlock Text="Port:" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="txtTcpPort" Text="502" Padding="5"/>
        </StackPanel>

        <!-- Serial Settings Panel -->
        <StackPanel x:Name="pnlSerialSettings" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="COM Port:" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbComPort" Padding="5" Grid.Column="0"/>
                <Button Content="Refresh" Grid.Column="1" Margin="5,0,0,0" Padding="10,5" Style="{StaticResource SecondaryButton}" Click="BtnRefreshPorts_Click"/>
            </Grid>

            <TextBlock Text="Baud Rate:" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <ComboBox x:Name="cmbBaudRate" Padding="5">
                <ComboBoxItem Content="9600" IsSelected="True"/>
                <ComboBoxItem Content="19200"/>
                <ComboBoxItem Content="38400"/>
                <ComboBoxItem Content="57600"/>
                <ComboBoxItem Content="115200"/>
            </ComboBox>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Parity:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbParity" Padding="5">
                        <ComboBoxItem Content="None" IsSelected="True"/>
                        <ComboBoxItem Content="Odd"/>
                        <ComboBoxItem Content="Even"/>
                        <ComboBoxItem Content="Mark"/>
                        <ComboBoxItem Content="Space"/>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Data Bits:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbDataBits" Padding="5">
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Stop Bits:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbStopBits" Padding="5">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="1" IsSelected="True"/>
                        <ComboBoxItem Content="1.5"/>
                        <ComboBoxItem Content="2"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Connect" Style="{StaticResource ModernButton}" Width="100" Click="BtnConnect_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
