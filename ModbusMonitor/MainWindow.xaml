<Window x:Class="ModbusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModbusMonitor"
        mc:Ignorable="d"
        Icon="img/logo.png"
        Title="Modbus Monitor" SizeToContent="Height" Width="1250" Background="#F8F9FA">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B5ED7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="EditButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="Button" x:Key="DeleteButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connection Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#DEE2E6" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtConnectionInfo" Text="No Connection Configured" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,20,0" FontSize="14"/>
                
                <Button x:Name="btnConnect" Content="Connect" Style="{StaticResource ModernButton}" Width="120" Click="BtnConnect_Click"/>
                <TextBlock x:Name="txtStatus" Text="Disconnected" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#DC3545" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Header Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Data Monitor" Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="#0D6EFD" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Border x:Name="brdBadgeInfo" Grid.Column="1" Background="#6C757D" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="txtBadgeInfo" Text="Disconnected" Foreground="White" FontSize="12"/>
            </Border>
            
            <Button x:Name="btnAddMonitor" Grid.Column="3" Content="+ Add Monitor" Style="{StaticResource ModernButton}" Click="BtnAddMonitor_Click" IsEnabled="False"/>
        </Grid>

        <!-- Tabs & DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl x:Name="mainTabControl" Grid.Row="0" Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged" IsEnabled="False">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#0D6EFD"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="#0D6EFD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- Coils -->
                <TabItem Header="Coils (0x)">
                    <DataGrid x:Name="dgCoils" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Coils}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slave ID" Binding="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding DisplayAddress, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTemplateColumn Header="Value (Click to Toggle)" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="Coil_Toggle_Click" Width="80" Height="30" Cursor="Hand">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="OFF (0)"/>
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="ON (1)"/>
                                                            <Setter Property="Background" Value="#198754"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Error" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Delete" Style="{StaticResource DeleteButton}" Click="BtnDelete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Discrete Inputs -->
                <TabItem Header="Discrete Inputs (1x)">
                    <DataGrid x:Name="dgDiscreteInputs" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding DiscreteInputs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slave ID" Binding="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding DisplayAddress, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTemplateColumn Header="Value" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Background="#F8F9FA"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Error" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Delete" Style="{StaticResource DeleteButton}" Click="BtnDelete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Input Registers -->
                <TabItem Header="Input Registers (3x)">
                    <DataGrid x:Name="dgInputRegisters" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding InputRegisters}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slave ID" Binding="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding DisplayAddress, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Endian" Binding="{Binding Endian}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTemplateColumn Header="Value" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Background="#F8F9FA"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Error" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource EditButton}" Margin="0,0,5,0" Click="BtnEdit_Click"/>
                                            <Button Content="Delete" Style="{StaticResource DeleteButton}" Click="BtnDelete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Holding Registers -->
                <TabItem Header="Holding Registers (4x)" IsSelected="True">
                    <DataGrid x:Name="dgHoldingRegisters" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding HoldingRegisters}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slave ID" Binding="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding DisplayAddress, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Endian" Binding="{Binding Endian}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTemplateColumn Header="Value (Enter to Save)" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" KeyDown="TxtValue_KeyDown" GotFocus="TxtValue_GotFocus" LostFocus="TxtValue_LostFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Error" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource EditButton}" Margin="0,0,5,0" Click="BtnEdit_Click"/>
                                            <Button Content="Delete" Style="{StaticResource DeleteButton}" Click="BtnDelete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,15,0">
                <ComboBox x:Name="cmbAddressBase" Width="200" SelectedIndex="0" Padding="5,2" Margin="0,0,15,0" SelectionChanged="CmbAddressBase_SelectionChanged">
                    <ComboBoxItem Content="address modbus start from 0"/>
                    <ComboBoxItem Content="address modbus start from 1"/>
                </ComboBox>
                
                <TextBlock Text="Scan Rate (ms):" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#6C757D" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="txtScanRate" Text="1000" Width="60" Padding="2" TextAlignment="Center" BorderBrush="#DEE2E6" Style="{StaticResource ModernTextBox}" LostFocus="TxtScanRate_LostFocus" KeyDown="TxtScanRate_KeyDown"/>
            </StackPanel>

            <!-- Pagination Footer -->
            <Border Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Background="#F8F9FA" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Page Size -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Show per page:" VerticalAlignment="Center" Foreground="#6C757D" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbPageSize" Width="60" SelectedIndex="0" SelectionChanged="CmbPageSize_SelectionChanged" Padding="5,2">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="40"/>
                            <ComboBoxItem Content="50"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Right: Pagination Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnPrevPage" Content="Previous" Width="70" Height="30" Background="#6C757D" Foreground="White" BorderThickness="0" Margin="0,0,15,0" Click="BtnPrevPage_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock x:Name="txtPageInfo" Text="Page 1 of 1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <Button x:Name="btnNextPage" Content="Next" Width="70" Height="30" Background="#0D6EFD" Foreground="White" BorderThickness="0" Click="BtnNextPage_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
